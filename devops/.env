#MS SQL Database
DB_SA_PASSWORD=as1stL4bIsB3stComp1ny
DB_NAME=Petsgram
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=${DB_SA_PASSWORD}
ConnectionStrings__DbConnection=Server=db;Database=${DB_NAME};User=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True

#WebAPI routing configuration
APP_PORT=8080
ASPNETCORE_URLS="http://+:${APP_PORT}"

#WebAPI storage settings
STORAGE__PHOTOPHYSICALPATH=/PetsgramApp/pet_photos
STORAGE__PHOTOPUBLICPATH=/pet_photos
Storage__PhotoPhysicalPath=${STORAGE__PHOTOPHYSICALPATH}
Storage__PhotoPublicPath=${STORAGE__PHOTOPUBLICPATH}

#WebAPI authorization settings
AUTHSETTINGS__SECRETKEY=c6e4e2b2d6533e661891e91be7d37b6fc4443ddfe9bd91de841a0e9effc6f543
AUTHSETTINGS__ISSUER=PetsgramApi
AUTHSETTINGS__AUDIENCE=PetsgramApiClient
AUTHSETTINGS__ACCESSTOKENEXPIREDAYS=7
AUTHSETTINGS__REFRESHTOKENEXPIREDAYS=30

#ExchangeRateAPI configuration
EXCHANGERATEAPI__APIKEY=f8fa7eb006268ffa35615cd5
EXCHANGERATEAPI__BASEURL=https://v6.exchangerate-api.com/v6
EXCHANGERATEAPI__DEFAULTBASECURRENCY=USD

#Admin seed for WebAPI
ADMIN__USERNAME=admin123
ADMIN__PASSWORD=admin123!

#Redis configuration
REDIS__CONNECTIONSTRING=redis:6379
REDIS__KEYPREFIX=petsgram:
#Default expitation in seconds
REDIS__DEFAULTEXPIRATION=600